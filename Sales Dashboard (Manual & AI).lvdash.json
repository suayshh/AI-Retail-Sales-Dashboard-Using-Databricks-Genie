{
  "datasets": [
    {
      "name": "ee61ecb0",
      "displayName": "Dashboar_Table_1",
      "queryLines": [
        "select \r\n",
        "o.order_id,\r\n",
        "o.total_amount,\r\n",
        "o.customer_id,\r\n",
        "o.product_id,\r\n",
        "o.order_at,\r\n",
        "p.category,\r\n",
        "CASE WHEN c.country_code = 'UK' THEN 'GB' ELSE c.country_code END AS country_code\r\n",
        "from sales_data.orders as o\r\n",
        "left join sales_data.products as p\r\n",
        "on o.product_id = p.product_id\r\n",
        "left join sales_data.customers as c\r\n",
        "on o.customer_id = c.customer_id\r\n",
        "\r\n"
      ]
    }
  ],
